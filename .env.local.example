# Subpfad-Deployment (leer lassen wenn die App auf / läuft)
# Muss zur BUILD-ZEIT gesetzt sein: docker build --build-arg NEXT_PUBLIC_BASE_PATH=/poehner
NEXT_PUBLIC_BASE_PATH=

# SMTP-Konfiguration für das Kontaktformular
# Datei kopieren zu .env.local und Werte eintragen

SMTP_HOST=mail.poehni.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=chris@poehni.de
SMTP_PASS=
SMTP_FROM=chris@poehni.de
SMTP_TO=chris@poehni.de
